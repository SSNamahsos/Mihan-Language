{
  "name": "mihan-language",
  "displayName": "Mihan Language",
  "description": "Mihan — a programming language that reads the way Persian is spoken. Autocomplete for keywords, builtins and your own names, signature help, hover docs, mistakes, go-to-definition and formatting. By Mihani Circle.",
  "version": "0.7.8",
  "publisher": "MihaniCircle",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "mihan",
    "mhn",
    "persian",
    "finglish"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#101216",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:mihan",
    "onDebugResolve:mihan",
    "onDebugDynamicConfigurations:mihan",
    "onCommand:mihan.runFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mihan",
        "aliases": [
          "Mihan",
          "mihan"
        ],
        "extensions": [
          ".mhn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mihan",
        "scopeName": "source.mihan",
        "path": "./syntaxes/mihan.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Mihan",
      "properties": {
        "mihan.path": {
          "type": "string",
          "default": "mihan",
          "markdownDescription": "Where the `mihan` command is. Leave this as `mihan` if `mihan install` has put it on your path; otherwise give the whole path to `mihan.exe`.",
          "scope": "machine-overridable"
        },
        "mihan.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Write everything sent to and from the language server into the Mihan output panel. Turn this on when something is not working and you want to see what was asked.",
          "scope": "window"
        }
      }
    },
    "configurationDefaults": {
      "[mihan]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.acceptSuggestionOnEnter": "on",
        "editor.snippetSuggestions": "inline",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestionsDelay": 10,
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnCommitCharacter": true,
        "editor.tabCompletion": "on",
        "editor.suggestSelection": "first",
        "editor.suggest.insertMode": "replace",
        "editor.suggest.localityBonus": true,
        "editor.suggest.showWords": false,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggest.preview": true,
        "editor.parameterHints.enabled": true
      }
    },
    "commands": [
      {
        "command": "mihan.restartLanguageServer",
        "title": "Mihan: Restart the language server",
        "category": "Mihan"
      },
      {
        "command": "mihan.showOutput",
        "title": "Mihan: Show the language server's messages",
        "category": "Mihan"
      },
      {
        "command": "mihan.newProgram",
        "title": "Mihan: Start a new program",
        "category": "Mihan"
      },
      {
        "command": "mihan.runFile",
        "title": "Mihan: Run this file",
        "category": "Mihan",
        "icon": "$(play)"
      },
      {
        "command": "mihan.debugFile",
        "title": "Mihan: Run in the Debug Console",
        "category": "Mihan",
        "icon": "$(debug-alt)"
      }
    ],
    "snippets": [
      {
        "language": "mihan",
        "path": "./snippets/mihan.json"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "mihan.runFile",
          "when": "resourceLangId == mihan",
          "group": "navigation@0"
        },
        {
          "command": "mihan.debugFile",
          "when": "resourceLangId == mihan",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "mihan.runFile",
          "when": "resourceLangId == mihan",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mihan.runFile",
          "when": "resourceLangId == mihan",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mihan.runFile",
          "when": "resourceLangId == mihan"
        },
        {
          "command": "mihan.debugFile",
          "when": "resourceLangId == mihan"
        }
      ]
    },
    "debuggers": [
      {
        "type": "mihan",
        "label": "Mihan",
        "languages": [
          "mihan"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .mhn file to run.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "The folder to run in.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Words passed to the program (arghoman).",
                "default": []
              },
              "console": {
                "type": "string",
                "enum": [
                  "debugConsole",
                  "integratedTerminal"
                ],
                "description": "Where the program runs. integratedTerminal lets it read typed input (khanak). Chosen automatically when left out."
              },
              "openBrowser": {
                "type": "boolean",
                "description": "Open a site in the browser (mihan run --open). Chosen automatically for files that serve a site."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mihan",
            "request": "launch",
            "name": "Mihan: run this file",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Mihan: run this file",
            "description": "Run the open .mhn file",
            "body": {
              "type": "mihan",
              "request": "launch",
              "name": "Mihan: run this file",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Mihan: program with input",
            "description": "Run in a terminal so khanak can read typed input",
            "body": {
              "type": "mihan",
              "request": "launch",
              "name": "Mihan: run with input",
              "program": "^\"\\${file}\"",
              "console": "integratedTerminal"
            }
          },
          {
            "label": "Mihan: website",
            "description": "Run a site and open it in the browser",
            "body": {
              "type": "mihan",
              "request": "launch",
              "name": "Mihan: run the site",
              "program": "^\"\\${file}\"",
              "openBrowser": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0"
  },
  "author": {
    "name": "Mihani Circle"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SSNamahsos/Mihan-Language"
  }
}
