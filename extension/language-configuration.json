{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(funct|def|fn|func|darghan|class|sakht|struct|shenase|enum|dastoor|interface|agar|if|warna|else|ta|while|har|for|koshish|try|giroft|catch|nemigir|finally)\\b.*$",
    "decreaseIndentPattern": "^\\s*(shek|edame|bargard|portab)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#khoroji\\s*$",
      "end": "^\\s*$"
    }
  }
}
